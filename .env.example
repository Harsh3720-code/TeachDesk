# TeachDesk configuration. Copy to .env and adjust; .env is never committed.
# Every variable is optional: the values below are the defaults.

# Deployment environment: local, test or production.
TEACHDESK_ENV=local

# Python log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
TEACHDESK_LOG_LEVEL=INFO

# Model for routing and quick checks (SPEC.md §4).
TEACHDESK_ROUTER_MODEL=claude-haiku-4-5-20251001

# Model for drafting letters, comments and adapted resources (SPEC.md §4).
TEACHDESK_DRAFTING_MODEL=claude-sonnet-5-5
